{#-
  ---------------------------------------------------------------------------
  Virtual host de NGINX para la maquina de PHP-FPM.

  A diferencia del virtual host de la maquina "web" (el proxy), este esta
  configurado con la directiva fastcgi_pass apuntando al puerto en el que
  realmente escucha PHP-FPM ({{ fpm_fastcgi_correct_port }} = 9000).

  En esta maquina NGINX esta instalado (lo instala este mismo rol), pero el
  virtual host NO se activa: no se crea el enlace en sites-enabled, porque
  aqui no tiene que servir nada. El trafico entra por la maquina "web" y se
  reenvia a PHP-FPM por FastCGI.
  ---------------------------------------------------------------------------
-#}
server {

    listen 80;

    server_name {{ nginx_site_name }};

    root {{ nginx_root }};
    index index.php;

    access_log /var/log/nginx/runningzones.access.log;
    error_log /var/log/nginx/runningzones.error.log;

    location / {

        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {

        include snippets/fastcgi-php.conf;

        fastcgi_pass 127.0.0.1:{{ fpm_fastcgi_correct_port }};

        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

        include fastcgi_params;
    }

    location ~ /\.ht {
        deny all;
    }
}
