# ==========================================================
# Inventario estatico de ejemplo (formato INI)
#
# SOLO se usa si prefieres gestionar las IPs a mano (por ejemplo, si ya
# tienes las instancias creadas desde la consola de AWS). En ese caso:
#
#   1. Copia este fichero a inventory/hosts.ini
#   2. Sustituye las IPs por las reales
#   3. No ejecutes `terraform apply` (o hazlo con -target="" para no tocar
#      las instancias)
#
# El inventario generado por Terraform tiene el mismo formato (y además
# rellena los datos del security group, que son los que usa el escenario
# de debugging).
# ==========================================================

[all:vars]
# --- Datos del security group de PHP-FPM -----------------------------------
# Los escribe Terraform. Si usas este inventario a mano, copia los valores
# reales de la consola de AWS (o de `terraform output`).
#
#   fpm_fastcgi_port         -> puerto destino de la regla FastCGI del SG
#                              (9000: el correcto, donde escucha PHP-FPM)
#   fpm_fastcgi_wrong_port   -> puerto erroneo al que apunta el fastcgi_pass
#                              del NGINX (9001: el error introducido)
#   fpm_fastcgi_correct_port -> puerto correcto (donde escucha PHP-FPM)
#   fpm_sg_id / web_sg_id    -> identificadores de los security groups
fpm_fastcgi_port=9000
fpm_fastcgi_wrong_port=9001
fpm_fastcgi_correct_port=9000
fpm_sg_id=sg-0000000000000000a
web_sg_id=sg-0000000000000000b

[web]
# IP publica de la instancia con NGINX
192.0.2.10 ansible_host=192.0.2.10

[web:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=../terraform/.ssh/running-zones-v3-debug.pem
ansible_python_interpreter=/usr/bin/python3

[fpm]
# IP publica de la instancia con PHP-FPM
192.0.2.20 ansible_host=192.0.2.20

[fpm:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=../terraform/.ssh/running-zones-v3-debug.pem
ansible_python_interpreter=/usr/bin/python3
